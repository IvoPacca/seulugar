rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }

    // System-level administrative verification
    function isSystemAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && (
          request.auth.token.email == 'ivoimbi5@gmail.com' ||
          request.auth.token.email.endsWith('@seulugar.ao')
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validate UserProfile schema properties
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'isAdmin', 'created_at'])
        && data.uid is string
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() <= 256
        && data.displayName is string
        && data.displayName.size() <= 256
        && data.photoURL is string
        && data.photoURL.size() <= 2048
        && data.isAdmin is bool
        && data.created_at is string;
    }

    // Validate Order schema properties
    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'userEmail', 'userName', 'totalPrice', 'paymentMethod', 'paymentReference', 'status', 'created_at'])
        && data.id is string
        && data.id.size() <= 128
        && data.userId is string
        && data.userId.size() <= 128
        && data.userEmail is string
        && data.userEmail.size() <= 256
        && data.userName is string
        && data.userName.size() <= 256
        && data.totalPrice is number
        && data.paymentMethod is string
        && data.paymentMethod.size() <= 64
        && data.paymentReference is string
        && data.paymentReference.size() <= 1024
        && data.status is string
        && data.status.size() <= 64
        && data.created_at is string;
    }

    // Validate WebhookLog schema properties
    function isValidWebhookLog(data) {
      return data.keys().hasAll(['id', 'receivedAt', 'method', 'url', 'ip', 'status'])
        && data.id is string
        && data.id.size() <= 128
        && data.receivedAt is string
        && data.method is string
        && data.method.size() <= 16
        && data.url is string
        && data.url.size() <= 1024
        && data.ip is string
        && data.ip.size() <= 64
        && data.status is string
        && data.status.size() <= 32;
    }

    // Match rules for UserProfiles
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isSystemAdmin());
      allow list: if isSystemAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming())
        && (incoming().isAdmin == false || 
            ('email' in request.auth.token && (
              request.auth.token.email == 'ivoimbi5@gmail.com' || 
              request.auth.token.email.endsWith('@seulugar.ao')
            )));
      allow update: if (isOwner(userId) || isSystemAdmin()) 
        && isValidUserProfile(incoming())
        && (incoming().isAdmin == existing().isAdmin || isSystemAdmin());
    }

    // Match rules for Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isSystemAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSystemAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidOrder(incoming());
      allow update: if isSystemAdmin() && isValidOrder(incoming());
      allow delete: if isSystemAdmin();
    }
    
    // Admins master register path
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSystemAdmin();
    }

    // Match rules for Webhook Logs
    match /webhook_logs/{logId} {
      allow read: if isSystemAdmin();
      allow create: if isValidWebhookLog(incoming());
      allow update, delete: if isSystemAdmin();
    }
  }
}
